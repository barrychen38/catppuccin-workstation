# Catppuccin Workstation — delta settings for git.
# Reference copy: install.sh applies these keys incrementally to your
# ~/.gitconfig with `git config --global`, leaving the rest untouched.

[include]
    path = ~/.config/git/catppuccin.gitconfig

[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    features = catppuccin-macchiato
    line-numbers = true
    decorations = commit-style box
    hide-plus-minus-markers = false
