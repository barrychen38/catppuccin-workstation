# Catppuccin Workstation — prompt and syntax highlighting.
# Sourced from ~/.zshrc via a managed block appended by install.sh.
# Command aliases, completion, and navigation belong to the user's own setup.

command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"

# Keep syntax highlighting after prompt initialization and user-defined widgets.
typeset _catppuccin_brew_prefix=""
if command -v brew >/dev/null 2>&1; then
  _catppuccin_brew_prefix="$(brew --prefix)"
fi
[[ -n "$_catppuccin_brew_prefix" && -r "$_catppuccin_brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] && source "$_catppuccin_brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
unset _catppuccin_brew_prefix
